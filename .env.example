# wishbeat — Umgebungsvariablen-Vorlage
#
# Anleitung:
# 1. Kopiere diese Datei zu .env.local (im selben Ordner)
# 2. Trage die echten Werte ein (NICHT in diese Datei!)
# 3. .env.local wird durch .gitignore automatisch geschützt und niemals committet.

# ---------------------------------------------------------------------------
# Spotify Web API
# ---------------------------------------------------------------------------
# So bekommst du diese Werte:
#   1. Gehe zu https://developer.spotify.com/dashboard
#   2. Melde dich mit deinem Spotify-Account an
#   3. "Create app" → Name: wishbeat, Redirect URI: http://localhost:3000/api/spotify/callback
#   4. Client-ID und Client-Secret kopieren

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# ---------------------------------------------------------------------------
# Supabase (Datenbank + Auth)
# ---------------------------------------------------------------------------
# So bekommst du diese Werte:
#   1. Gehe zu https://supabase.com und lege ein neues Projekt an (kostenlos)
#   2. Im Dashboard: Settings → API
#   3. Project URL und anon/public Key kopieren

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-Role-Key NUR serverseitig verwenden, niemals im Browser-Code!
SUPABASE_SERVICE_ROLE_KEY=
